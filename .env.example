# Get your key at console.anthropic.com
# Add this in Vercel: Project → Settings → Environment Variables
# Any of the API routes will also accept the legacy name `mindy_secret_key`
# if that's what's already set on Vercel — but new setups should use this one.
ANTHROPIC_API_KEY=sk-ant-...

# Turnout safety-report email alert (see docs/turnout-alerts.md). Set these in Vercel too.
TURNOUT_ALERT_SECRET=a-long-random-string-the-same-value-is-stored-in-the-database
RESEND_API_KEY=re_...
TURNOUT_ALERT_TO=you@example.com
# Optional: "all" (default) or "serious" (only unsafe/harassment/inappropriate, or about a circle owner)
# TURNOUT_ALERT_LEVEL=all
# Optional: a sender on a domain you verified with Resend (default is Resend's test sender)
# TURNOUT_ALERT_FROM=Turnout alerts <alerts@yourdomain.com>
